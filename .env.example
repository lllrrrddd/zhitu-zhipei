# 环境变量示例：复制成 .env.local 后按需修改（不会进仓库）
#
# 说明：本项目直接读进程环境变量，不自动加载 .env 文件。
# 用 scripts\start-lan.ps1 时会自动设置下面大部分；手动起服务时照着设即可。

# ── 运行位置 ──────────────────────────────────────────────
# 前端产物目录（npm run build 的产物），单端口部署必须设
RF_FRONTEND_DIST=source\ResumeForge\frontend\dist
# 数据目录（SQLite、附件、导出物都在这里）
RF_DATA_DIR=runtime\lan-data

# ── 账号与门禁 ────────────────────────────────────────────
# 1=需要登录（局域网/公网），0=单机不登录
ZY_REQUIRE_LOGIN=1
# 站点是 http 时必须为 0，否则浏览器不发送会话 cookie
ZY_COOKIE_SECURE=0
# 允许的浏览器来源主机（逗号分隔）。填局域网 IP，否则所有写请求返回 403
ZY_TRUSTED_ORIGIN_HOSTS=192.168.0.10,127.0.0.1,localhost
# 管理员密钥：发邀请码/重置码要用，对外前务必改掉
ZY_ADMIN_KEY=change-me
# 1=注册必须持邀请码（公网/给别人用时建议打开），0/不设=开放注册
ZY_REQUIRE_INVITE=0
# 首启自动创建的邀请码（8 位数字，可留空）
ZY_INVITE_CODE=12345678

# ── 语音识别（可选） ──────────────────────────────────────
# 指向解压后的模型目录；目录名含 sense-voice 走 SenseVoice，否则按 Paraformer
# 未设置或目录不存在时，接口返回 503，界面提示"请改用打字"
ZY_ASR_MODEL_DIR=runtime\models\asr\sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2025-09-09
